#include <windows.h>

#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
// Icon. The first icon in the file is the one Explorer shows for the
// executable, so IDI_APP_ICON is deliberately the lowest identifier.

IDI_APP_ICON ICON "app.ico"

/////////////////////////////////////////////////////////////////////////////
// Application manifest: DPI awareness, common controls v6 and asInvoker.

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

/////////////////////////////////////////////////////////////////////////////
// Version information.

VS_VERSION_INFO VERSIONINFO
    FILEVERSION 2, 0, 0, 0
    PRODUCTVERSION 2, 0, 0, 0
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS VS_FF_DEBUG
#else
    FILEFLAGS 0x0L
#endif
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "Lucas Lapaz"
            VALUE "FileDescription", "Media Control"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "MediaControl"
            VALUE "LegalCopyright", "Lucas Lapaz"
            VALUE "OriginalFilename", "MediaControl.exe"
            VALUE "ProductName", "Media Control"
            VALUE "ProductVersion", "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        /* Portuguese (Brazil), Unicode */
        VALUE "Translation", 0x416, 1200
    END
END
